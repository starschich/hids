% =============================================================
%  attemplate.sty — entry point for American Terawatt reports
%
%  Usage in the main document (path is relative to the main .tex):
%
%      \usepackage{../../template/attemplate}
%
%  From a document that is NOT two levels below the repository root,
%  declare the path to the template folder before loading the package:
%
%      \providecommand{\attemplatepath}{../template/}
%      \usepackage{../template/attemplate}
%
%  Public interface (provided by atreportcorporate.sty):
%    \reporttitle \reportsubtitle \reportauthor \reportdocnumber
%    \reportrevision \reportstatus \reportdate \reportconfidentiality
%    \makecover \revisionhistory \revrow
%
%  HISTORY
%  -------
%  This file used to be a selector between four house styles
%  (classic / brand / house / corporate) chosen by a package option,
%  plus a block of compatibility shims that let one document body
%  compile under any of them. Only `corporate' was ever used, so the
%  other three styles and their asset folders were archived and this
%  file reduced to a plain wrapper. The shims went with them: none of
%  the macros they covered (\atheadrow, \atlead, \atDriver, \atTBD,
%  \atSource, \atBackCover and the rest) is referenced by the document.
%
%  The option form still works -- \usepackage[corporate]{...} -- so
%  existing documents need no edit; any other option is reported.
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{attemplate}[2026/09/03 American Terawatt report template]

\DeclareOption{corporate}{}
\DeclareOption*{\PackageWarning{attemplate}{%
  Unknown template `\CurrentOption'. Only `corporate' remains; the
  classic, brand and house variants were archived}}
\ProcessOptions\relax

% Where the template folder sits, relative to the main document. The
% default matches the usual documentation/<name>/ and specification/<name>/
% depth; a document at another depth defines \attemplatepath before
% loading this package (see the usage note above).
\providecommand{\attemplatepath}{../../template/}
\edef\at@requirestyle{\noexpand\RequirePackage{\attemplatepath atreportcorporate}}
\at@requirestyle

\endinput
