% =============================================================
%  atreport.sty — American Terawatt technical report style
%  Brand basis: the American Terawatt presentation template
%  (stark black/white, amber accent, Helvetica-like sans).
%
%  Usage (from a report folder next to this template folder):
%     \documentclass[11pt,a4paper]{article}
%     \usepackage{../template/atreport}
%  Compile with pdflatex (run twice for ToC / references).
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atreport}[2026/08/03 American Terawatt report style]

% ---- Packages -----------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{helvet}                 % Helvetica-like sans
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[a4paper,margin=2.5cm,headheight=16pt,headsep=18pt,footskip=28pt]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage[hidelinks]{hyperref}

% =============================================================
%  BRAND PALETTE  (edit to retheme)
% =============================================================
\definecolor{atBlack}{HTML}{0A0A0A}   % near-black
\definecolor{atInk}{HTML}{111111}     % body text
\definecolor{atPaper}{HTML}{FFFFFF}   % white
\definecolor{atGray}{HTML}{6B7280}    % muted gray
\definecolor{atLine}{HTML}{E5E5E5}    % hairline rules
\definecolor{atAccent}{HTML}{E0A03C}  % electric amber

\color{atInk}
\linespread{1.06}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\hypersetup{colorlinks=false, linkcolor=atInk, urlcolor=atAccent, citecolor=atInk}

% ---- Wordmark ------------------------------------------------
\newcommand{\atwordmark}{{\bfseries AMERICAN\,TERAWATT}}

% =============================================================
%  DOCUMENT METADATA (set these in the preamble of a report)
% =============================================================
\newcommand{\atStoredTitle}{Technical Report}
\newcommand{\atStoredSubtitle}{}
\newcommand{\atStoredAuthor}{American Terawatt}
\newcommand{\atStoredDate}{\today}
\newcommand{\atStoredDocNo}{ATW-REP-000}
\newcommand{\atStoredRev}{0.1}
\newcommand{\atStoredStatus}{Draft}
\newcommand{\atStoredConf}{Confidential}

\newcommand{\reporttitle}[1]{\renewcommand{\atStoredTitle}{#1}}
\newcommand{\reportsubtitle}[1]{\renewcommand{\atStoredSubtitle}{#1}}
\newcommand{\reportauthor}[1]{\renewcommand{\atStoredAuthor}{#1}}
\newcommand{\reportdate}[1]{\renewcommand{\atStoredDate}{#1}}
\newcommand{\reportdocnumber}[1]{\renewcommand{\atStoredDocNo}{#1}}
\newcommand{\reportrevision}[1]{\renewcommand{\atStoredRev}{#1}}
\newcommand{\reportstatus}[1]{\renewcommand{\atStoredStatus}{#1}}
\newcommand{\reportconfidentiality}[1]{\renewcommand{\atStoredConf}{#1}}

% =============================================================
%  SECTION FORMATTING (amber accent rule under each section)
% =============================================================
\titleformat{\section}
  {\Large\bfseries\color{atBlack}}{\thesection}{0.6em}{}
  [{\vspace{0.2em}\color{atAccent}\titlerule[2pt]}]
\titleformat{\subsection}
  {\large\bfseries\color{atBlack}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}
  {\normalsize\bfseries\color{atInk}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.6em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.3em}

% Every top-level section (chapter) starts on a new page.
\newcommand{\sectionbreak}{\clearpage}

% ---- Captions ------------------------------------------------
\captionsetup{font=small, labelfont={bf,color=atInk}, textfont={color=atGray}}

% ---- Lists ---------------------------------------------------
\setlist[itemize]{leftmargin=1.4em, itemsep=0.25em, topsep=0.3em}
\setlist[enumerate]{leftmargin=1.6em, itemsep=0.25em, topsep=0.3em}
\renewcommand{\labelitemi}{\textcolor{atAccent}{\small\raisebox{0.15ex}{\rule{0.5ex}{0.5ex}}}}

% =============================================================
%  HEADER / FOOTER
% =============================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\color{atGray}\atwordmark}
\fancyhead[R]{\footnotesize\color{atGray}\atStoredDocNo\ \textbullet\ Rev.\ \atStoredRev}
\fancyfoot[L]{\footnotesize\color{atGray}\atStoredConf}
\fancyfoot[C]{\footnotesize\color{atGray}\atStoredTitle}
\fancyfoot[R]{\footnotesize\color{atGray}\thepage}
\renewcommand{\headrule}{\color{atLine}\rule{\headwidth}{0.4pt}}
\renewcommand{\footrule}{\color{atLine}\rule{\headwidth}{0.4pt}\vspace{2pt}}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% =============================================================
%  COVER PAGE  —  \makecover
% =============================================================
\newcommand{\makecover}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \color{atInk}
  \vspace*{0.4cm}
  {\fontsize{13}{15}\selectfont \atwordmark}\par
  \vspace{3.2cm}
  {\color{atAccent}\rule{3.5cm}{3pt}}\par
  \vspace{0.6em}
  {\fontsize{30}{36}\selectfont\bfseries\color{atBlack}\atStoredTitle\par}
  \ifx\atStoredSubtitle\empty\else
    \vspace{0.5em}{\Large\color{atGray}\atStoredSubtitle\par}
  \fi
  \vfill
  % ---- metadata block ----
  {\color{atLine}\rule{\linewidth}{0.6pt}}\par
  \vspace{0.8em}
  % Neutralise global parskip / linespread so both columns align row-by-row.
  \begingroup
  \setlength{\parskip}{0pt}\linespread{1}\selectfont
  \renewcommand{\arraystretch}{1.5}
  \begin{tabularx}{\linewidth}{@{}>{\color{atGray}}l >{\raggedright\arraybackslash}X@{}}
    Document       & \atStoredDocNo \\
    Classification & \atStoredConf \\
  \end{tabularx}
  \endgroup
  \vspace{0.8em}
  {\color{atLine}\rule{\linewidth}{0.6pt}}\par
  \vspace{1.4em}
  {\footnotesize\color{atGray}\textcopyright\ \the\year\ American Terawatt. \atStoredConf.}
  \end{titlepage}
}

% ---- Revision history table helper --------------------------
% \revisionhistory{ \revrow{...}{...}{...}{...} ... }
\newcommand{\revrow}[4]{#1 & #2 & #3 & #4 \\}
\newcommand{\revisionhistory}[1]{%
  \section*{Revision history}
  \renewcommand{\arraystretch}{1.3}
  \begin{tabularx}{\linewidth}{@{}l l l X@{}}
    \toprule
    \textbf{Rev.} & \textbf{Date} & \textbf{Author} & \textbf{Description} \\
    \midrule
    #1
    \bottomrule
  \end{tabularx}
  \vspace{1em}
}

% ---- Table of contents styling ------------------------------
\renewcommand{\contentsname}{Contents}
\titlecontents{section}[0pt]{\vspace{0.3em}\bfseries}
  {\thecontentslabel\quad}{}{\hfill\contentspage}
\titlecontents{subsection}[1.6em]{\vspace{0.1em}}
  {\thecontentslabel\quad}{}{\hfill\contentspage}

\endinput
