\atEyebrow{}
\atRunningHead{}
\atAbstract{}
\newcommand{\atStrapline}{AMERICA'S PRIVATE INDUSTRIAL POWER GRID}
\newcommand{\atConfidential}{Confidential, not for public disclosure}

