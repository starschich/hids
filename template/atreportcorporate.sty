% =============================================================
%  Tables: Slate head, Beige bands, Warm Grey hairlines
% =============================================================
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
% Ragged-right fixed-width column: use this (not plain p{...}) for any
% narrow column that carries a short header label such as "Rev." or
% "Ref.". A plain, fully-justified p{...} column that is narrower than
% its header word cannot hyphenate a short all-caps label and TeX
% pushes it onto an overfull second line, leaving the header looking
% mis-aligned; \raggedright lets the word simply sit on the first line.
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
% Header cell: colors its own cell with \cellcolor and sets white text
% directly, rather than relying on \rowcolor for the header row.
% \rowcolor shifts a narrow first p{}/X-type column's baseline down by
% one line when combined with colortbl (a colortbl + tabularx
% interaction, reproducible even with single-line, unstretched cells),
% which left a short all-caps label like "REV." floating below the
% rest of the header row. \cellcolor per cell does not have this bug.
\newcommand{\atHead}[1]{\cellcolor{atSlate}\textbf{\fontsize{8}{10}\selectfont
                        \color{white}\MakeUppercase{#1}}}
% attable: styled table; the first row is the header row (built from
% \atHead cells, which supply their own Slate background).
% (\NewEnviron is used so tabularx sees a complete body, avoiding the
% "File ended while scanning use of \TX@get@body" error that
% \newenvironment{...}{\begin{tabularx}...}{\end{tabularx}} causes.)
\NewEnviron{attable}[1]{%
  \begingroup
  \renewcommand{\arraystretch}{1.35}%
  \arrayrulecolor{atWarmGrey}%
  \rowcolors{2}{}{atBeige}%
  \begin{tabularx}{\linewidth}{#1}
  \BODY
  \end{tabularx}%
  \endgroup}
\newcommand{\atTotalRow}{\rowcolor{atWarmGrey}}
\newcommand{\atTBD}{{\bfseries\color{atSlate}TBD}}
\newcommand{\atTBC}{{\bfseries\color{atSlate}TBC}}
\newcommand{\atSource}[1]{\par\vspace{5pt}{\fontsize{8}{11}\selectfont #1}\par\vspace{14pt}}
\newcommand{\atCaption}[1]{\par\vspace{5pt}{\fontsize{8}{11}\selectfont #1}\par\vspace{14pt}}

% House look for plain booktabs tables in the document body:
% Warm Grey hairlines and Beige alternate bands.
\arrayrulecolor{atWarmGrey}
\renewcommand{\arraystretch}{1.35}
\setlength{\aboverulesep}{0pt}
\setlength{\belowrulesep}{0pt}
\AtBeginEnvironment{tabular}{\rowcolors{2}{}{atBeige}}
\AtBeginEnvironment{tabularx}{\rowcolors{2}{}{atBeige}}

% ---- captions ---------------------------------------------------
% Captions are centred (both single- and multi-line: singlelinecheck
% must be TRUE so short captions are centred rather than flush left,
% and justification=centering handles the ones that wrap), with the
% "Figure N:" / "Table N:" label part set bold.
\captionsetup{font={footnotesize,color=atCharcoal},
              labelfont={footnotesize,bf,color=atCharcoal},
              labelsep=colon,justification=centering,
              singlelinecheck=true,skip=5pt}

% ---- figure placeholder ------------------------------------------
\newcommand{\atFigureSlot}[2][170pt]{%
  \par\vspace{8pt}\noindent
  \fcolorbox{atWarmGrey}{atBeige}{%
    \parbox[c][#1][c]{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}%
    {\centering\ttfamily\fontsize{8}{12}\selectfont #2}}\par}

% =============================================================
%  Cover: white, left-aligned, no page number
% =============================================================
\newcommand{\atCover}{%
  \begin{titlepage}
  \atNoNetting
  \newgeometry{margin=0pt}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt,xshift=0.80in,yshift=-0.75in]
      at (current page.north west)
      {\includegraphics[width=1.10in]{\atcorpasset{at-logo.png}}};
    \node[anchor=north west,inner sep=0pt,xshift=0.80in,yshift=-4.20in]
      at (current page.north west)
      {\begin{minipage}{6.20in}
        {\color{atSand}\rule{\linewidth}{1pt}}\\[22pt]
        \ifdefempty{\@atEyebrow}{}{%
          {\bfseries\fontsize{8.5}{11}\selectfont\color{atSlate}%
           \MakeUppercase{\@atEyebrow}}\\[20pt]}%
        {\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
         \bfseries\fontsize{40}{42}\selectfont\color{atCharcoal}\@atTitle}\\[8pt]
        {\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
         \fontsize{22}{26}\selectfont\color{atStone}\@atSubtitle}\\[26pt]
        \ifdefempty{\@atAbstract}{}{%
          \parbox{4.4in}{\fontsize{10.5}{17}\selectfont\color{atCharcoal}%
                         \@atAbstract}}
      \end{minipage}};
    \node[anchor=south west,inner sep=0pt,xshift=0.80in,yshift=0.75in]
      at (current page.south west)
      {\begin{minipage}{6.20in}
        {\color{atWarmGrey}\rule{\linewidth}{0.5pt}}\\[12pt]
        \at@buildcovermeta
        \ifdefempty{\at@metatext}{}{%
          {\fontsize{8.5}{11}\selectfont\color{atStone}\at@metatext}}\hfill
        {\bfseries\fontsize{7.5}{10}\selectfont\color{atStone}%
               \MakeUppercase{\atConfidential}}
      \end{minipage}};
  \end{tikzpicture}
  \restoregeometry
  \end{titlepage}%
  \setcounter{page}{2}%
  \atNetting}

% cover metadata line (document number, revision, status, date): only
% the fields that are set are included. The native class has no slot
% for this, so it is built here and printed at the bottom of the
% cover, on the same line as "CONFIDENTIAL" (see \atCover above).
% \at@buildcovermeta only computes \at@metatext; it prints nothing
% itself, so it can be called wherever the line should appear.
\newcommand{\at@metatext}{}
\newif\ifat@metafirst
% NOTE on the implementation: earlier drafts tried to build up
% \at@metatext with a manual triple-\expandafter+\gdef chain, and later
% with a plain \xdef. Both are unsafe here:
%  - the \expandafter chain only expands \at@metatext's PRIOR value one
%    level and leaves the freshly-inserted separator token deferred
%    inside the stored macro, so it later resolves to whatever the
%    separator happens to hold at that time -- producing a spurious
%    leading bullet.
%  - a plain \xdef forces FULL expansion of everything in its
%    replacement text, including \quad and \textbullet; those aren't
%    meant to be expanded outside of normal execution, and doing so
%    sends NFSS's font-substitution machinery into a recursive loop
%    ("TeX capacity exceeded ... \curr@fontshape").
% The kernel's \g@addto@macro is the safe idiom: it expands only the
% accumulator macro itself (via \toks@\expandafter{#1#2}), never the
% newly-appended tokens, so \quad/\textbullet are copied verbatim and
% only ever expanded normally, at print time. A simple flag (instead of
% a deferred "separator macro") decides whether a leading bullet is
% needed, so there is no deferred-expansion trap left at all.
\newcommand{\at@metaitem}[1]{%
  \ifdefempty{#1}{}{%
    \ifat@metafirst
      \g@addto@macro\at@metatext{\quad\textbullet\quad #1}%
    \else
      \g@addto@macro\at@metatext{#1}%
      \global\at@metafirsttrue
    \fi}}
\newcommand{\at@buildcovermeta}{%
  \global\at@metafirstfalse
  \gdef\at@metatext{}%
  \at@metaitem{\at@DocNumber}%
  \ifdefempty{\at@Revision}{}{%
    \ifat@metafirst
      \g@addto@macro\at@metatext{\quad\textbullet\quad Rev.~\at@Revision}%
    \else
      \g@addto@macro\at@metatext{Rev.~\at@Revision}%
      \global\at@metafirsttrue
    \fi}%
  \at@metaitem{\at@Status}%
  \at@metaitem{\at@Date}}

% no back cover in this template; kept as a no-op for compatibility
% with documents that call it after switching from another variant.
\providecommand{\atBackCover}{}

% atreport interface
\newcommand{\makecover}{\atCover}

% =============================================================
%  Revision history
% =============================================================
\newcommand{\revrow}[4]{#1 & #2 & #3 & #4 \\}
\newcommand{\revisionhistory}[1]{%
  \section*{Revision history}%
  \begingroup
  \renewcommand{\arraystretch}{1.35}%
  \arrayrulecolor{atWarmGrey}%
  \rowcolors{2}{}{atBeige}%
  \begin{tabularx}{\linewidth}{@{}P{0.07\linewidth} P{0.17\linewidth}
                               P{0.20\linewidth} L@{}}
    \atHead{Rev.} & \atHead{Date} & \atHead{Author} & \atHead{Description}\\
    #1
  \end{tabularx}%
  \endgroup
  \par\vspace{12pt}}

\endinput
