% =============================================================
%  atreportcorporate.sty
%  American Terawatt report style — CORPORATE variant
%
%  Package form of the second "americanterawatt.cls" house template:
%  white cover (no photo), Charcoal body, Slate blue table heads and
%  sub-heads, Warm Grey hairlines, Sand grid netting down the left
%  page edge.
%
%  Two interfaces are available:
%
%  1) the atreport interface, so the same document body works with
%     every template variant:
%       \reporttitle \reportsubtitle \reportauthor \reportdocnumber
%       \reportrevision \reportstatus \reportdate \reportconfidentiality
%       \makecover \revisionhistory \revrow
%
%  2) the native interface from this template's americanterawatt.cls:
%       \atTitle \atSubtitle \atEyebrow \atRunningHead \atAbstract
%       \atCover \atNetting \atDriver \atTBD \atTBC \atFigureSlot
%       \atSource \atCaption  and the attable environment
%
%  Assets expected in  <this folder>/assets-corporate/ :
%    at-logo.png  at-wordmark.png  at-mark.png
%  (at-rail.png is no longer used -- the left-edge grid rail is drawn as
%   vector artwork in \at@railgrid below.)
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atreportcorporate}[2026/08/19 American Terawatt corporate report style]

