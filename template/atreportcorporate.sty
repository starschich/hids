% =============================================================
%  atreportcorporate.sty
%  American Terawatt report style
%
%  Originally the package form of the second "americanterawatt.cls"
%  house template; since aligned to the design system at
%  design.amwatt.vercel.app. White cover, ink body copy, Label-style
%  (Geist Mono, caps, tracked) table heads on a subtle ground, hairline
%  borders, and the Energy edge bar down the left page edge.
%
%  This is now the only report style -- the classic, brand and house
%  variants were archived. Two command sets are available:
%
%  1) the portable interface, which is what documents should use:
%       \reporttitle \reportsubtitle \reportauthor \reportdocnumber
%       \reportrevision \reportstatus \reportdate \reportconfidentiality
%       \makecover \revisionhistory \revrow
%
%  2) the native interface inherited from americanterawatt.cls:
%       \atTitle \atSubtitle \atEyebrow \atRunningHead \atAbstract
%       \atCover \atNetting \atDriver \atTBD \atTBC \atFigureSlot
%       \atSource \atCaption  and the attable environment
%     Nothing in the current document uses these; they are kept so the
%     inherited vendor markup still compiles.
%
%  Assets expected in  <this folder>/assets-corporate/ :
%    at-logo.pdf  at-wordmark.pdf  at-mark.pdf
%  All three are vector PDFs. The .png twins that used to be referenced
%  here were archived -- same artwork, same aspect ratios, but raster.
%  The left edge bar needs no asset at all; it is drawn as vector.
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atreportcorporate}[2026/08/19 American Terawatt corporate report style]

% ---- packages -----------------------------------------------
% Brand typography (Archivo + Geist Mono when compiled with
% lualatex/xelatex and the font files are installed; Helvetica
% otherwise). See atfonts.sty.
\RequirePackage{../../template/atfonts}
% Typography helpers this file uses from atfonts.sty, provided
% defensively. \providecommand leaves them untouched when atfonts.sty
% already defines them, so this costs nothing when the two files are in
% step -- but it keeps THIS file compiling when they are not. Older
% copies of atfonts.sty (before the Archivo rewrite) define only
% \atLightFace and \atMediumFace, and without the two lines below the
% build dies with "Undefined control sequence \atLabelFace" once per
% table head and page header -- 64 times in this document.
%
% These were previously covered by a block of \providecommand shims in
% attemplate.sty. That block was removed as unused, which was true of
% the document body but NOT of this template: the shims were also the
% only thing keeping the two files loosely coupled.
\providecommand{\atLabelFace}{\bfseries}
\providecommand{\atTabularFigures}{}
\IfFileExists{fontsize.sty}{\RequirePackage[fontsize=10pt]{fontsize}}{}
\RequirePackage[letterpaper,top=0.72in,bottom=0.72in,left=1.15in,right=0.85in,
                headsep=16pt,footskip=26pt]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage[table,dvipsnames]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{environ}
\RequirePackage{etoolbox}
\RequirePackage{textcomp}
\RequirePackage[hidelinks]{hyperref}

% ---- asset path ---------------------------------------------
% Resolved relative to the main document; adjust if the template
% folder is moved.
\providecommand{\atcorpassetpath}{../../template/assets-corporate/}
\newcommand{\atcorpasset}[1]{\atcorpassetpath#1}

% ---- palette: design-system tokens ---------------------------
% Named after the semantic tokens in design.amwatt.vercel.app
% /foundations/color (light theme) so a future design-system revision
% maps one-to-one onto this block. The DS forbids hard-coding hexes in
% favour of semantic tokens; these definitions are the LaTeX equivalent
% of that token layer, and nothing below this block should introduce a
% raw hex.
%
%   token            hex       DS role
\definecolor{atFg}          {HTML}{121212} % --fg            body and heading text
\definecolor{atFgMuted}     {HTML}{635E56} % --fg-muted      secondary text, captions
\definecolor{atFgSubtle}    {HTML}{79746B} % --fg-subtle     placeholders, disabled
\definecolor{atFgOnAccent}  {HTML}{121212} % --fg-on-accent  text on Energy: always ink
\definecolor{atBg}          {HTML}{FCFCFC} % --bg            page ground (paper stays white in print)
\definecolor{atBgSubtle}    {HTML}{F6F6F4} % --bg-subtle     table headers, recessed panels
\definecolor{atBgMuted}     {HTML}{DBD8D2} % --bg-muted      inactive chips, track fills
\definecolor{atBorder}      {HTML}{E4E3DA} % --border        default hairline
\definecolor{atBorderStrong}{HTML}{9C8F83} % --border-strong emphasised dividers
\definecolor{atAccent}      {HTML}{CEEB11} % --accent        Energy: the edge bar
\definecolor{atAccentFg}    {HTML}{5E7400} % --accent-fg     Energy as text or icon
\definecolor{atInfo}        {HTML}{5089A6} % --info          Slate: neutral status only
\definecolor{atSuccess}     {HTML}{5F8E00} % --success
\definecolor{atWarning}     {HTML}{D7B718} % --warning
\definecolor{atDanger}      {HTML}{EA553E} % --danger

\AtBeginDocument{\color{atFg}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{7pt plus 2pt minus 1pt}

