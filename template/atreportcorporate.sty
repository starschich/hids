% Running head defaults to the title, flattened, unless the document
% sets \atRunningHead natively. The eyebrow (small caps line above the
% cover title) has no equivalent in the atreport interface, so it is
% left blank and simply omitted from the cover unless the document
% calls \atEyebrow directly.
\AtBeginDocument{%
  \ifdefempty{\@atRunningHead}{%
    \begingroup
      \renewcommand{\\}{ }%
      \protected@xdef\@atRunningHead{\@atTitle}%
    \endgroup}{}}

% =============================================================
%  Edge bar (every body page)
% =============================================================
%  Per the design system's Edge Bar device
%  (design.amwatt.vercel.app/foundations/lattice): "A 36-pixel
%  Energy-coloured vertical rail runs down the left edge, carrying the
%  logomark and rotated capital letters. This device belongs to
%  presentation and print -- not to product interfaces."
%
%  This replaces the Sand grid netting that came from the vendor
%  americanterawatt.cls. Two notes on why that had to go:
%    * Sand is not a colour token in the DS at all -- it appears only as
%      a dark-theme warning tone -- so the old rail was off-system.
%    * The fine 0.11in grid was not the DS lattice either. The lattice is
%      a 165.58px-pitch grid with a star at every intersection, Energy
%      coloured, and the DS allows only one per page ("it is a signature,
%      and a signature loses its force when repeated"). A full-height
%      rail of it on every page would breach that, so the edge bar is a
%      solid Energy field instead.
%
%  36px at the DS's 96dpi reference = 0.375in. Everything on the bar is
%  positioned from \at@railwidth, so changing that one length moves the
%  bar, the mark and the strapline together.
\newif\ifat@net \at@netfalse
\newcommand{\atNetting}{\global\at@nettrue}
\newcommand{\atNoNetting}{\global\at@netfalse}

\newlength{\at@railwidth}\setlength{\at@railwidth}{0.375in}

\AddToShipoutPictureBG{%
  \ifat@net
    % the Energy field itself
    \put(0,0){\begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\at@railwidth,\paperheight);
      \fill[atAccent] (0,0) rectangle (\at@railwidth,\paperheight);
    \end{tikzpicture}}%
    \put(0,0){\begin{tikzpicture}[remember picture,overlay]
      % Logomark, centred across the bar. anchor=north centres the box on
      % the anchor, so the shift must be to the bar's centreline
      % (0.5*\at@railwidth) -- padding the image inside the node instead
      % would move it only half as far and leave it straddling the edge.
      % The mark is dark ink, which is also what the DS requires of
      % anything sitting on Energy (--fg-on-accent: "always ink, never
      % white" -- white lands around 1.5:1 and is unreadable).
      \node[anchor=north,inner sep=0pt]
        at ([xshift=0.5\at@railwidth,yshift=-0.28in]current page.north west)
        {\includegraphics[width=0.185in]{\atcorpasset{at-mark.pdf}}};
      % Rotated capitals. anchor=west (not south) under rotate=90 puts the
      % START of the line at the anchor and runs it upward, so yshift is
      % literally the clear distance from the bottom edge to the first
      % letter. Set in the DS Label style (Geist Mono, caps, tracked) via
      % \atLabelFace, in ink on the Energy ground.
      \node[anchor=west,rotate=90,inner sep=0pt]
        at ([xshift=0.5\at@railwidth,yshift=0.90in]current page.south west)
        {\atLabelFace\fontsize{6.5}{8}\selectfont\color{atFgOnAccent}%
         \MakeUppercase{\atStrapline}};
    \end{tikzpicture}}%
  \fi}

% =============================================================
%  Header and footer
% =============================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\includegraphics[height=9pt]{\atcorpasset{at-wordmark.pdf}}}
% Running head and footer are instrumentation, not prose: DS Label
% style (Geist Mono, caps, tracked) in secondary ink.
\fancyhead[R]{\atLabelFace\fontsize{7.5}{10}\selectfont\color{atFgMuted}%
              \MakeUppercase{\@atRunningHead}}
\fancyfoot[L]{\atLabelFace\fontsize{7.5}{10}\selectfont\color{atFgMuted}%
              \MakeUppercase{\atConfidential}}
% NB: the caps here are written literally rather than via
% \MakeUppercase. \MakeUppercase uppercases EVERYTHING in its argument,
% including the label name inside \pageref -- \pageref{LastPage} became
% \pageref{LASTPAGE}, an undefined reference, so every footer printed
% "PAGE n OF ??" and the log carried 13 undefined-reference warnings.
\fancyfoot[R]{\atLabelFace\fontsize{7.5}{10}\selectfont\color{atFgMuted}%
              PAGE \thepage\ OF \pageref{LastPage}}
