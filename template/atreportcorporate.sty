% Running head defaults to the title, flattened, unless the document
% sets \atRunningHead natively. The eyebrow (small caps line above the
% cover title) has no equivalent in the atreport interface, so it is
% left blank and simply omitted from the cover unless the document
% calls \atEyebrow directly.
\AtBeginDocument{%
  \ifdefempty{\@atRunningHead}{%
    \begingroup
      \renewcommand{\\}{ }%
      \protected@xdef\@atRunningHead{\@atTitle}%
    \endgroup}{}}

% =============================================================
%  Sand grid netting (every body page)
% =============================================================
\newif\ifat@net \at@netfalse
\newcommand{\atNetting}{\global\at@nettrue}
\newcommand{\atNoNetting}{\global\at@netfalse}

% Rail geometry. These are the single source of truth for the rail's
% width and grid pitch: the grid, the mark and the strapline are all
% positioned from them, so changing \at@railwidth moves everything
% together and keeps the centring correct.
\newlength{\at@railwidth}\setlength{\at@railwidth}{0.44in}
\newlength{\at@railstep} \setlength{\at@railstep}{0.11in}

% The rail used to be a 132x3300 px raster (assets-corporate/at-rail.png).
% It is a plain square grid, so it is drawn as true vector artwork here
% instead -- resolution-independent, no asset file, and it rescales with
% the lengths above. Geometry and colour were reverse-engineered from the
% original bitmap: 0.11in pitch, 0.48pt strokes, atSand at 25% opacity on
% white (the PNG's line pixels measured rgb(242,234,223), which is
% exactly atSand at 25% over white).
%
% The rules are stroked as separate vertical and horizontal paths rather
% than as one TikZ \grid on purpose. PDF applies constant alpha per path,
% so a single self-overlapping grid path renders every crossing at the
% same 25% as the rules -- whereas the original bitmap has visibly darker
% dots at the crossings. Two sets of paths composite (25% over 25% =
% 43.75%), which restores that texture. It is still a little lighter than
% the source bitmap's crossings (~69%); no single stroke alpha can match
% both the rules and the crossings, so the rules -- by far the dominant
% element -- are the ones matched exactly.
%
% Row/column counts are derived from \paperheight and the lengths above
% (over-counted by one row and clipped), so the rail also survives a
% change of paper size.
\newcommand{\at@railgrid}{%
  \begingroup
  \edef\at@railcols{\the\numexpr\number\dimexpr\at@railwidth\relax
                    /\number\dimexpr\at@railstep\relax\relax}%
  \edef\at@railrows{\the\numexpr\number\dimexpr\paperheight\relax
                    /\number\dimexpr\at@railstep\relax+1\relax}%
  \begin{tikzpicture}[x=\at@railstep,y=\at@railstep,
                      atSand,opacity=0.25,line width=0.48pt]
    \useasboundingbox (0,0) rectangle (\at@railwidth,\paperheight);
    \clip (0,0) rectangle (\at@railwidth,\paperheight);
    \foreach \i in {0,...,\at@railcols}{%
      \draw (\i,0) -- (\i,\at@railrows);}%
    \foreach \j in {0,...,\at@railrows}{%
      \draw (0,\j) -- (\at@railcols,\j);}%
  \end{tikzpicture}%
  \endgroup}

\AddToShipoutPictureBG{%
  \ifat@net
    \put(0,0){\at@railgrid}%
    \put(0,0){\begin{tikzpicture}[remember picture,overlay]
      % Mark centred across the rail. The rail is 0.44in wide, so its
      % centreline is at x=0.22in: shifting the anchor there and letting
      % anchor=north centre the box on it is what actually centres the
      % mark. (It was previously padded with \hspace{0.22in} inside an
      % anchor=north node, which centres the box on the PAGE EDGE and so
      % left the mark straddling the rail's left edge, clipped by the
      % paper edge -- the padding shifted the image only half as far as
      % intended.)
      \node[anchor=north,inner sep=0pt]
        at ([xshift=0.5\at@railwidth,yshift=-0.30in]current page.north west)
        {\includegraphics[width=0.20in]{\atcorpasset{at-mark.png}}};
      % Rotated strapline on the rail. anchor=west (not south) is what
      % makes the placement predictable under rotate=90: the START of
      % the text sits exactly at the anchor and the line runs upward,
      % so yshift is literally the clear distance from the bottom edge
      % to the first letter. With anchor=south the node was positioned
      % by the middle of its length instead, which pushed the leading
      % word ("AMERICA'S") off the bottom of the page.
      \node[anchor=west,rotate=90,inner sep=0pt]
        at ([xshift=0.5\at@railwidth,yshift=0.90in]current page.south west)
        {\fontsize{7}{9}\selectfont\bfseries\color{atCharcoal}\atStrapline};
    \end{tikzpicture}}%
  \fi}

